# Copy to .env and fill in. .env is gitignored.
#
# Neo4j Aura: the credentials file Aura downloads uses NEO4J_USERNAME and, on
# some instances, sets both the username and the database to the instance id
# rather than "neo4j". Check which pair your instance accepts.
NEO4J_URI=neo4j+s://<instance>.databases.neo4j.io
NEO4J_USER=<instance-id or neo4j>
NEO4J_PASSWORD=
NEO4J_DATABASE=<instance-id or neo4j>

# Local Neo4j instead:
# NEO4J_URI=neo4j://127.0.0.1:7687
# NEO4J_USER=neo4j
# NEO4J_DATABASE=neo4j

OLLAMA_HOST=http://127.0.0.1:11434
DPDP_MODEL=qwen2.5:3b-instruct
