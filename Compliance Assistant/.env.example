# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Neo4j (required) -------------------------------------------------------
# The graph is the source of truth at runtime. Aura note: some instances
# require the username and database to be the instance id rather than "neo4j".
NEO4J_URI=neo4j+s://<instance>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Language model ---------------------------------------------------------
# ollama (default, local, no key) or claude (hosted, needs ANTHROPIC_API_KEY).
DPDP_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
DPDP_MODEL=qwen2.5:3b-instruct
# ANTHROPIC_API_KEY=

# --- Behaviour --------------------------------------------------------------
# DPDP_MAX_CONTEXT_CHARS=10000
# DPDP_ABSTAIN_THRESHOLD=15.0

# --- Tracing (optional) ------------------------------------------------------
# Off unless BOTH are set. https://cloud.langfuse.com, or your self-hosted URL.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- HTTP -------------------------------------------------------------------
# Leave empty for same-origin (the frontend is served by this app).
# Comma-separated list if a separate origin must call the API. "*" is refused.
# DPDP_CORS_ORIGINS=

# Never enable in production: surfaces internal error detail and enables /docs.
# DPDP_DEBUG=0
